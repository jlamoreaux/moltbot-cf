# Moltbot Cloudflare - Environment Variables
# Copy to .env.local and fill in your values

# Required: Gateway authentication token
CLAWDBOT_GATEWAY_TOKEN=

# Required: AI provider API key
ANTHROPIC_API_KEY=

# Optional: Web search
BRAVE_API_KEY=

# Optional: Additional AI provider
OPENAI_API_KEY=

# Optional: Channel tokens
DISCORD_TOKEN=
TELEGRAM_TOKEN=
